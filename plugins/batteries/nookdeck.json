{
  "$schema": "https://nookdeck.app/schema/plugin.json",
  "id": "dev.nookdeck.batteries",
  "name": "Batteries",
  "version": "1.0.1",
  "nookdeck": ">=0.5.1",
  "author": "Nookdeck",
  "description": "Battery of your Mac, Magic keyboard, mouse and trackpad, and AirPods",
  "os": ["darwin"],
  "permissions": { "shell": true },
  "widgets": [
    {
      "id": "levels",
      "name": "Batteries",
      "render": "card",
      "sizes": ["1x1", "2x1", "2x2", "4x2"],
      "preview": { "root": { "t": "col", "gap": 2, "children": [
        { "t": "row", "gap": 2, "grow": true, "children": [
          { "t": "ring", "value": 0.95, "tone": "ok", "icon": "device-laptop", "size": "m", "label": "⚡︎ 95%" },
          { "t": "ring", "value": 0.18, "tone": "bad", "icon": "mouse", "size": "m", "label": "18%" }
        ] },
        { "t": "row", "gap": 2, "grow": true, "children": [
          { "t": "ring", "value": 0.62, "tone": "ok", "icon": "keyboard", "size": "m", "label": "62%" },
          { "t": "ring", "value": 0.8, "tone": "ok", "icon": "headphones", "size": "m", "label": "80%" }
        ] }
      ] } },
      "settings": [
        { "key": "style", "type": "select", "label": "Style (auto: by the tile size)", "options": ["auto", "rings", "row", "list", "lowest"], "default": "auto" },
        { "key": "showMac", "type": "boolean", "label": "Show this Mac's battery", "default": true }
      ]
    }
  ],
  "actions": [],
  "main": "src/index.ts"
}
