{
  "$schema": "https://nookdeck.app/schema/plugin.json",
  "id": "dev.nookdeck.batteries",
  "name": "Batteries",
  "version": "1.0.0",
  "nookdeck": ">=0.5.0",
  "author": "Nookdeck",
  "description": "Battery of your Mac, Magic keyboard, mouse and trackpad, and AirPods",
  "os": ["darwin"],
  "permissions": { "shell": true },
  "widgets": [
    {
      "id": "levels",
      "name": "Batteries",
      "render": "card",
      "sizes": ["2x1", "2x2", "4x2"],
      "preview": { "root": { "t": "col", "gap": 2, "children": [
        { "t": "row", "gap": 2, "align": "center", "children": [
          { "t": "icon", "name": "device-laptop" },
          { "t": "col", "gap": 0, "grow": true, "children": [ { "t": "text", "text": "This Mac", "size": "s" }, { "t": "progress", "value": 0.95 } ] },
          { "t": "text", "text": "95%", "bold": true }
        ] },
        { "t": "row", "gap": 2, "align": "center", "children": [
          { "t": "icon", "name": "keyboard" },
          { "t": "col", "gap": 0, "grow": true, "children": [ { "t": "text", "text": "Magic Keyboard", "size": "s" }, { "t": "progress", "value": 0.62 } ] },
          { "t": "text", "text": "62%", "bold": true }
        ] },
        { "t": "row", "gap": 2, "align": "center", "children": [
          { "t": "icon", "name": "headphones" },
          { "t": "col", "gap": 0, "grow": true, "children": [ { "t": "text", "text": "AirPods Pro", "size": "s" }, { "t": "progress", "value": 0.18, "tone": "warn" } ] },
          { "t": "text", "text": "18%", "bold": true, "tone": "warn" }
        ] }
      ] } },
      "settings": [
        { "key": "showMac", "type": "boolean", "label": "Show this Mac's battery", "default": true }
      ]
    }
  ],
  "actions": [],
  "main": "src/index.ts"
}
