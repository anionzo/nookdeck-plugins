{
  "$schema": "https://nookdeck.app/schema/plugin.json",
  "id": "dev.nookdeck.shortcuts",
  "name": "Apple Shortcuts",
  "version": "1.0.0",
  "nookdeck": ">=0.5.1",
  "author": "Nookdeck",
  "description": "Run your Apple Shortcuts from the phone",
  "os": ["darwin"],
  "permissions": { "shell": true },
  "widgets": [
    {
      "id": "list",
      "name": "Shortcuts",
      "render": "card",
      "sizes": ["2x1", "2x2", "4x2"],
      "preview": { "root": { "t": "col", "gap": 1, "children": [
        { "t": "row", "gap": 1, "grow": true, "children": [
          { "t": "button", "label": "Start focus", "icon": "clock", "layout": "tile", "action": "run", "args": { "name": "Start focus" } },
          { "t": "button", "label": "Open Today", "icon": "app-window", "layout": "tile", "action": "run", "args": { "name": "Open Today" } }
        ] },
        { "t": "row", "gap": 1, "grow": true, "children": [
          { "t": "button", "label": "Take a break", "icon": "bolt", "layout": "tile", "action": "run", "args": { "name": "Take a break" } },
          { "t": "button", "label": "Backup notes", "icon": "file-text", "layout": "tile", "action": "run", "args": { "name": "Backup notes" } }
        ] }
      ] } },
      "settings": [
        { "key": "folder", "type": "string", "label": "Folder (empty: all shortcuts)", "default": "" },
        { "key": "names", "type": "string", "label": "Or only these names, separated by commas", "default": "" },
        { "key": "columns", "type": "select", "label": "Buttons per row (auto: by the tile size)", "options": ["auto", "1", "2", "3", "4", "5", "6"], "default": "auto" },
        { "key": "max", "type": "number", "label": "Most buttons to show (0: by the tile size)", "default": 0 }
      ]
    }
  ],
  "actions": [
    { "id": "run", "name": "Run a shortcut", "settings": [{ "key": "name", "type": "string", "label": "Shortcut name", "default": "" }] }
  ],
  "main": "src/index.ts"
}
