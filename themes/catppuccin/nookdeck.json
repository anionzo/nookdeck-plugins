{
  "$schema": "https://nookdeck.app/schema/plugin.json",
  "type": "theme",
  "id": "dev.nookdeck.catppuccin",
  "name": "Catppuccin",
  "version": "1.0.0",
  "nookdeck": ">=0.4.0",
  "author": "Nookdeck (port of Catppuccin)",
  "description": "Catppuccin, the soothing pastel theme: Latte, Frappé, Macchiato and Mocha, with a choice of 14 accents.",
  "preview": "previews/mocha.png",
  "theme": {
    "tileStyle": "solid",
    "radius": 16,
    "gap": 10
  },
  "auto": {
    "light": "latte",
    "dark": "mocha"
  },
  "variants": [
    {
      "id": "latte",
      "name": "Latte",
      "mode": "light",
      "theme": {
        "accent": "#8839ef",
        "background": "#eff1f5",
        "gradient": {
          "from": "#dce0e8",
          "to": "#eff1f5",
          "angle": 180
        },
        "tile": "#ccd0da",
        "text": "#4c4f69",
        "muted": "#6c6f85",
        "border": {
          "width": 1,
          "color": "#bcc0cc"
        },
        "palette": {
          "ok": "#40a02b",
          "warn": "#df8e1d",
          "error": "#d20f39",
          "info": "#1e66f5"
        },
        "chartColors": [
          "#8839ef",
          "#1e66f5",
          "#40a02b",
          "#fe640b",
          "#ea76cb",
          "#179299"
        ]
      },
      "preview": "previews/latte.png"
    },
    {
