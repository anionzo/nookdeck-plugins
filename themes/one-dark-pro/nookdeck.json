  "name": "One Dark Pro",
  "version": "1.0.0",
  "nookdeck": ">=0.4.0",
  "author": "Nookdeck (port of One Dark Pro)",
  "description": "One Dark Pro: Atom's iconic One Dark, as ported to VS Code. One Dark Pro, Flat, Darker, Mix and Night Flat.",
  "preview": "previews/one-dark-pro.png",
  "theme": {
    "tileStyle": "solid",
    "radius": 14,
    "gap": 10
